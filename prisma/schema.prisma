generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  userID       String  @id @default(uuid())
  email        String  @unique
  firstname    String
  surname      String
  addressLine1 String
  addressLine2 String?
  postcode     String
  passwordHash String

  createdAt DateTime @default(now())

  roleID String?

  role    Role?    @relation(fields: [roleID], references: [roleID], onDelete: SetNull, onUpdate: Cascade)
  baskets Basket[]
}

model Product {
  productID   String    @id @default(uuid())
  name        String
  description String?
  quantity    Int
  draft       Boolean   @default(true)
  visible     Boolean   @default(false)
  weight      Float
  deletedAt   DateTime?

  baskets       Basket[]
  categories    ProductCategories[]
  prices        ProductPrices[]
  productImages ProductImage[]
}

model ProductImage {
  imageID   String  @id @default(uuid())
  productID String
  imageUrl  String
  product   Product @relation(fields: [productID], references: [productID], onDelete: Cascade, onUpdate: Cascade)
}

model Basket {
  userID    String
  productID String
  quantity  Int

  user    User    @relation(fields: [userID], references: [userID], onDelete: Cascade, onUpdate: Cascade)
  product Product @relation(fields: [productID], references: [productID], onDelete: Cascade, onUpdate: Cascade)

  @@id([userID, productID])
}

model Department {
  departmentID String  @id @default(uuid())
  name         String
  description  String?

  categories Category[]
}

model Category {
  categoryID   String  @id @default(uuid())
  name         String
  description  String?
  departmentID String

  department Department @relation(fields: [departmentID], references: [departmentID], onDelete: Cascade, onUpdate: Cascade)

  products ProductCategories[]
}

model ProductCategories {
  productID  String
  categoryID String

  product  Product  @relation(fields: [productID], references: [productID], onDelete: Cascade, onUpdate: Cascade)
  category Category @relation(fields: [categoryID], references: [categoryID], onDelete: Cascade, onUpdate: Cascade)

  @@id([productID, categoryID])
}

model ProductPrices {
  priceID   String   @id @default(uuid())
  productID String
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productID], references: [productID], onDelete: Cascade, onUpdate: Cascade)
}

model Role {
  roleID      String  @id @default(uuid())
  name        String  @unique
  description String?
  accessLevel Int

  createdAt DateTime @default(now())

  users User[]
}
