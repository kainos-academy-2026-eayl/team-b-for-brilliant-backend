generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  userID       String  @id @default(uuid())
  email        String  @unique
  firstname    String?
  surname      String?
  addressLine1 String?
  addressLine2 String?
  postcode     String?
  passwordHash String

  createdAt DateTime @default(now())

  roleID String?
  role   Role?   @relation(fields: [roleID], references: [roleID], onDelete: SetNull, onUpdate: Cascade)

  securityQuestionID String?
  securityQuestion   SecurityQuestion? @relation(fields: [securityQuestionID], references: [questionID], onDelete: SetNull, onUpdate: Cascade)
  securityAnswer     String?
  baskets            Basket[]
  orders             Order[]
}

model SecurityQuestion {
  questionID String @id @default(uuid())
  question   String

  users User[]
}

model Product {
  productID   String    @id @default(uuid())
  name        String
  description String?
  quantity    Int
  draft       Boolean   @default(true)
  visible     Boolean   @default(false)
  weight      Float
  salesNo     Int       @default(0)
  deletedAt   DateTime?

  baskets           Basket[]
  orderItems        OrderItem[]
  productCategories ProductCategories[]
  productPrices     ProductPrices[]
  productImages     ProductImage[]
}

model ProductImage {
  imageID    String  @id @default(uuid())
  productID  String
  imageUrl   String
  imageOrder Int
  product    Product @relation(fields: [productID], references: [productID], onDelete: Cascade, onUpdate: Cascade)
}

model Basket {
  basketID  String   @id @default(uuid())
  userID    String
  productID String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userID], references: [userID], onDelete: Cascade, onUpdate: Cascade)
  product Product @relation(fields: [productID], references: [productID], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userID, productID])
}

model Order {
  orderID    String   @id @default(uuid())
  userID String
  createdAt  DateTime @default(now())

  discountID String?
  user   User    @relation(fields: [userID], references: [userID], onDelete: Restrict, onUpdate: Cascade)
  discount   Discounts?  @relation(fields: [discountID], references: [discountID], onDelete: SetNull, onUpdate: Cascade)
  orderItems OrderItem[]
}

model OrderItem {
  orderItemID String  @id @default(uuid())
  orderID     String
  productID   String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderID], references: [orderID], onDelete: Cascade, onUpdate: Cascade)
  product Product @relation(fields: [productID], references: [productID], onDelete: Restrict, onUpdate: Cascade)
}

model Department {
  departmentID String  @id @default(uuid())
  name         String
  description  String?

  categories Category[]
}

model Category {
  categoryID   String  @id @default(uuid())
  name         String
  description  String?
  departmentID String

  department Department @relation(fields: [departmentID], references: [departmentID], onDelete: Cascade, onUpdate: Cascade)

  products ProductCategories[]
}

model ProductCategories {
  productID  String
  categoryID String

  product  Product  @relation(fields: [productID], references: [productID], onDelete: Cascade, onUpdate: Cascade)
  category Category @relation(fields: [categoryID], references: [categoryID], onDelete: Cascade, onUpdate: Cascade)

  @@id([productID, categoryID])
}

model ProductPrices {
  priceID   String   @id @default(uuid())
  productID String
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productID], references: [productID], onDelete: Cascade, onUpdate: Cascade)
}

model Role {
  roleID      String  @id @default(uuid())
  name        String  @unique
  description String?
  accessLevel Int

  createdAt DateTime @default(now())

  users User[]
}

model Discounts {
  discountID String       @id @default(uuid())
  code       String       @unique
  type       DiscountType
  value      Decimal      @db.Decimal(10, 2)
  createdAt  DateTime     @default(now())
  expiryDate DateTime

  orders Order[]
}

model Order {
  orderID    String      @id @default(uuid())
  userID String
  createdAt  DateTime    @default(now())
  discountID String?
  user   User    @relation(fields: [userID], references: [userID], onDelete: Restrict, onUpdate: Cascade)
  discount   Discounts?  @relation(fields: [discountID], references: [discountID], onDelete: SetNull, onUpdate: Cascade)
  orderItems OrderItem[]
}

model OrderItem {
  orderItemID String  @id @default(uuid())
  orderID     String
  productID   String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderID], references: [orderID], onDelete: Cascade, onUpdate: Cascade)
  product Product @relation(fields: [productID], references: [productID], onDelete: Restrict, onUpdate: Cascade)
}

model Discounts {
  discountID String       @id @default(uuid())
  code       String       @unique
  type       DiscountType
  value      Decimal      @db.Decimal(10, 2)
  createdAt  DateTime     @default(now())
  expiryDate DateTime

  orders Order[]
}

enum DiscountType {
  PERCENTAGE
  AMOUNT_OFF
}
