{
  "name": "e-commerce-platform-backend",
  "version": "0.1.0",
  "description": "An e-commerce platform backend service",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js --sourcemap",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check . --write --error-on-warnings",
    "prepare": "husky",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev && npm run prisma:generate",
    "prisma:studio": "prisma studio",
    "prisma:seed": "npm run prisma:generate && prisma db seed",
    "pretypecheck": "npm run prisma:generate",
    "typecheck": "tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "keywords": [],
  "author": "John & Luke",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "@types/supertest": "7.2.1",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "zod": "4.6.7"
  }
}
