{
  "name": "e-commerce-platform-backend",
  "version": "0.1.0",
  "description": "An e-commerce platform backend service",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js --sourcemap",
    "typecheck": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [],
  "author": "John & Luke",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "lint": "^1.2.2",
    "playwright": "^1.64.1"
  }
}
