{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!src/generated",
      "!!package-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": {
                  "kind": "variable",
                  "scope": "global"
                },
                "match": "(id|db|i|j|k|.{3,})",
                "formats": [
                  "camelCase",
                  "PascalCase",
                  "CONSTANT_CASE"
                ]
              },
              {
                "selector": {
                  "kind": "variable"
                },
                "match": "(id|db|i|j|k|.{3,})",
                "formats": [
                  "camelCase",
                  "PascalCase"
                ]
              },
              {
                "selector": {
                  "kind": "functionParameter"
                },
                "match": "(id|db|i|j|k|.{3,})",
                "formats": [
                  "camelCase",
                  "PascalCase"
                ]
              },
              {
                "selector": {
                  "kind": "catchParameter"
                },
                "match": "(id|db|i|j|k|.{3,})",
                "formats": [
                  "camelCase"
                ]
              },
              {
                "selector": {
                  "kind": "indexParameter"
                },
                "match": "(id|db|i|j|k|.{3,})",
                "formats": [
                  "camelCase"
                ]
              },
              {
                "match": ".*"
              }
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}